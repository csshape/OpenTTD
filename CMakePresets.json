{
  "version": 3,
  "configurePresets": [
    {
      "name": "macos-xcode-universal",
      "displayName": "macOS Xcode Universal",
      "description": "Generate an Xcode project for a universal macOS build (arm64 and x86_64).",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/xcode-universal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "10.15",
        "APPLE_UNIVERSAL_PACKAGE": "ON",
        "OPTION_INSTALL_FHS": "OFF",
        "CMAKE_DISABLE_FIND_PACKAGE_PNG": "TRUE",
        "CMAKE_DISABLE_FIND_PACKAGE_LZO": "TRUE"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-xcode-universal-build",
      "displayName": "Build OpenTTD (macOS universal)",
      "configurePreset": "macos-xcode-universal",
      "configuration": "RelWithDebInfo",
      "targets": [
        "openttd"
      ]
    },
    {
      "name": "macos-xcode-universal-package",
      "displayName": "Package OpenTTD (macOS universal)",
      "configurePreset": "macos-xcode-universal",
      "configuration": "RelWithDebInfo",
      "targets": [
        "package"
      ]
    }
  ]
}
