{
  "version": 3,
  "configurePresets": [
    {
      "name": "macos-xcode-universal",
      "displayName": "macOS Xcode Universal",
      "description": "Generate an Xcode project for a universal macOS build (arm64 and x86_64).",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/xcode-universal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "10.15",
        "APPLE_UNIVERSAL_PACKAGE": "ON",
        "OPTION_INSTALL_FHS": "OFF",
        "CMAKE_DISABLE_FIND_PACKAGE_PNG": "TRUE",
        "CMAKE_DISABLE_FIND_PACKAGE_LZO": "TRUE"
      }
    },
    {
      "name": "ios-device-xcode-release",
      "displayName": "iPadOS Device Release (Xcode)",
      "description": "Generate an Xcode project for iPad device release builds.",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/xcode-ios-device-release",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang++",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "18.0",
        "CMAKE_BUILD_TYPE": "Release",
        "HOST_BINARY_DIR": "${sourceDir}/build/xcode-universal",
        "OPTION_INSTALL_FHS": "OFF",
        "CMAKE_DISABLE_FIND_PACKAGE_PNG": "TRUE",
        "CMAKE_DISABLE_FIND_PACKAGE_LZO": "TRUE",
        "CMAKE_DISABLE_FIND_PACKAGE_ALLEGRO": "TRUE",
        "CMAKE_DISABLE_FIND_PACKAGE_Fluidsynth": "TRUE",
        "CMAKE_DISABLE_FIND_PACKAGE_Harfbuzz": "TRUE",
        "CMAKE_DISABLE_FIND_PACKAGE_ICU": "TRUE",
        "CMAKE_DISABLE_FIND_PACKAGE_unofficial-breakpad": "TRUE"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-xcode-universal-build",
      "displayName": "Build OpenTTD (macOS universal)",
      "configurePreset": "macos-xcode-universal",
      "configuration": "RelWithDebInfo",
      "targets": [
        "openttd"
      ]
    },
    {
      "name": "macos-xcode-universal-package",
      "displayName": "Package OpenTTD (macOS universal)",
      "configurePreset": "macos-xcode-universal",
      "configuration": "RelWithDebInfo",
      "targets": [
        "package"
      ]
    },
    {
      "name": "macos-xcode-universal-tools-release",
      "displayName": "Build host tools (macOS universal, Release)",
      "configurePreset": "macos-xcode-universal",
      "configuration": "Release",
      "targets": [
        "strgen",
        "settingsgen"
      ]
    },
    {
      "name": "ios-device-build-release",
      "displayName": "Build OpenTTD (iPad device release)",
      "configurePreset": "ios-device-xcode-release",
      "configuration": "Release",
      "targets": [
        "openttd"
      ]
    }
  ]
}
